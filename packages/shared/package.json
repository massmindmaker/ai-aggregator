{
  "name": "@aiag/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./validation": {
      "import": "./dist/validation.js",
      "types": "./dist/validation.d.ts"
    },
    "./ton-payment-contract": {
      "types": "./dist/ton-payment-contract.d.ts",
      "import": "./dist/ton-payment-contract.js"
    },
    "./catalog-contract": {
      "types": "./dist/catalog-contract.d.ts",
      "import": "./dist/catalog-contract.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "undici": "7.30.0",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@aiag/typescript-config": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
