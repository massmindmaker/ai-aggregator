{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node",
      "vitest/globals"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/ton-payment-reconciler.ts",
    "src/ton-payment-bootstrap.ts",
    "src/ton-recovery-*.ts",
    "src/__tests__/ton-recovery.fixture.ts",
    "src/__tests__/ton-payment-reconciler*.test.ts",
    "src/__tests__/ton-payment-bootstrap.test.ts",
    "src/__tests__/ton-payment-recovery-boundary.test.ts",
    "src/ton-settlement-result.ts",
    "src/__tests__/ton-settlement*.ts",
    "src/__tests__/ton-payment-settlement*.ts",
    "src/__tests__/ton-payment-import-boundary.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
