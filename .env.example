# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Neon connection parameters
PGHOST="ep-xxx-pooler.aws.neon.tech"
PGHOST_UNPOOLED="ep-xxx.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="your-password"

# Vercel Postgres compatibility
POSTGRES_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_HOST="ep-xxx-pooler.aws.neon.tech"
POSTGRES_PASSWORD="your-password"
POSTGRES_DATABASE="neondb"
POSTGRES_PRISMA_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"

# ===========================================
# Neon Auth (Stack Auth)
# ===========================================
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_xxx"
STACK_SECRET_SERVER_KEY="ssk_xxx"

# ===========================================
# NextAuth.js
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# OAuth Providers (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# Tinkoff Acquiring
# ===========================================
TINKOFF_TERMINAL_KEY="your-terminal-key"
TINKOFF_SECRET_KEY="your-secret-key"
TINKOFF_API_URL="https://securepay.tinkoff.ru/v2"

# ===========================================
# S3 Storage (Yandex Cloud Object Storage)
# ===========================================
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="aiag-storage"
S3_REGION="ru-central1"

# ===========================================
# Redis (for rate limiting and caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# Application
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ===========================================
# --- TMA / membership NFT ---
# (apps/tg-miniapp + apps/agent-worker — separate product from the ₽ stack
# above; see /CLAUDE.md "TWO SEPARATE PRODUCTS". DATABASE_URL above is reused
# as-is for this stack too — it points at the Timeweb-managed Postgres on
# prod, not Neon; only the connection string value differs per environment.)
# ===========================================

# required — TMA JWT is HS256-pinned; process refuses to start (throws at
# module load) if unset or shorter than 32 chars. Gates every /api/tma/* route,
# including all membership endpoints.
TMA_JWT_SECRET=""

# required — the TON collection address the membership-reconciler checks
# on-chain and the purchase route mints into. WITHOUT IT: startMembershipReconciler()
# logs an error and stays DISABLED — membership purchases go pending forever
# and are NEVER granted (this is the exact silent-degradation the missing var caused).
MEMBERSHIP_NFT_COLLECTION_ADDRESS=""

# required for prod scale (technically optional) — tonapi.io API key used by
# the membership-reconciler to check wallet ownership on-chain. WITHOUT IT:
# reconciler falls back to public tonapi's ~1 req/s limit and starts 429-ing
# once more than ~25-30 wallets are pending per tick.
TONAPI_KEY=""

# optional — tonapi.io base URL. Default: https://tonapi.io/v2
TONAPI_BASE_URL=""

# optional — Startonus API base URL. Default: https://bot.startonus.com/api
STARTONUS_BASE_URL=""

# required — Startonus API secret used to mint the membership NFT on purchase.
# WITHOUT IT: the purchase route cannot request a mint; purchases fail closed.
STARTONUS_SECRET=""

# required — Startonus mint-set template id (an integer, not an address) for
# the membership collection. WITHOUT IT: membership mint requests are rejected
# by Startonus / cannot be built.
STARTONUS_MEMBERSHIP_MINT_TEMPLATE_ID=""

# required — shared bearer token the membership webhook route checks on
# incoming Startonus mint-confirmation callbacks. WITHOUT IT: the webhook
# route rejects every callback (401), relying entirely on the reconciler's
# polling loop to ever grant membership.
TRANSFER_WEBHOOK_SECRET=""

# optional — public base URL used to build the webhook callback URL handed to
# Startonus on mint. Default: https://app.ai-aggregator.ru
PUBLIC_BASE_URL=""
