# AI Aggregator Database Configuration
# Copy this file to .env and fill in your actual values

# ==============================================================================
# MongoDB Atlas Configuration
# ==============================================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/app?retryWrites=true&w=majority

# Alternative MongoDB Atlas credentials (if not using URI)
MONGODB_ATLAS_USERNAME=your-username
MONGODB_ATLAS_PASSWORD=your-password
MONGODB_ATLAS_DATABASE=app

# ==============================================================================
# Vercel Postgres Configuration
# ==============================================================================

# Vercel Postgres connection string
# Format: postgres://username:password@hostname:5432/database
POSTGRES_URL=postgres://username:password@hostname:5432/database

# Alternative PostgreSQL credentials (if not using URL)
POSTGRES_USERNAME=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=your-host.postgres.vercel-storage.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=your-database

# ==============================================================================
# Application Configuration
# ==============================================================================

# Environment
NODE_ENV=production

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-key-here

# Base URL for the application
VERCEL_URL=https://your-app.vercel.app

# ==============================================================================
# Migration Configuration
# ==============================================================================

# Force migration even if target databases have data
FORCE_MIGRATION=false

# Batch size for data migration
MIGRATION_BATCH_SIZE=1000

# Enable detailed migration logging
MIGRATION_VERBOSE=true

# ==============================================================================
# Monitoring Configuration
# ==============================================================================

# Enable database monitoring
DB_MONITORING_ENABLED=true

# Monitoring check interval (milliseconds)
DB_MONITORING_INTERVAL=30000

# Alert threshold (consecutive failures)
DB_MONITORING_ALERT_THRESHOLD=3

# Performance threshold (milliseconds)
DB_MONITORING_PERFORMANCE_THRESHOLD=1000

# ==============================================================================
# Development Configuration
# ==============================================================================

# Local MongoDB URI for development
MONGODB_LOCAL_URI=mongodb://localhost:27017/aiag_dev

# Local PostgreSQL URI for development
POSTGRES_LOCAL_URI=postgresql://localhost:5432/aiag_dev

# ==============================================================================
# Backup Configuration
# ==============================================================================

# Backup directory
BACKUP_DIR=./backups

# Enable automatic backups before migration
AUTO_BACKUP=true

# ==============================================================================
# Security Configuration
# ==============================================================================

# Enable SSL/TLS for database connections
DB_SSL_ENABLED=true

# SSL certificate validation
DB_SSL_VALIDATE=false

# IP whitelist for database access (comma-separated)
DB_IP_WHITELIST=0.0.0.0/0

# ==============================================================================
# Performance Configuration
# ==============================================================================

# MongoDB connection pool settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME=30000

# PostgreSQL connection pool settings
POSTGRES_MAX_POOL_SIZE=5
POSTGRES_MIN_POOL_SIZE=0
POSTGRES_IDLE_TIMEOUT=30000

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable database query logging
DB_QUERY_LOGGING=false

# Enable performance monitoring
PERFORMANCE_MONITORING=true

# ==============================================================================
# External Services
# ==============================================================================

# Vercel API token (for managing Postgres databases)
VERCEL_TOKEN=your-vercel-token

# MongoDB Atlas API key (for managing clusters)
MONGODB_ATLAS_API_KEY=your-atlas-api-key

# ==============================================================================
# Feature Flags
# ==============================================================================

# Enable cross-database analytics
ENABLE_CROSS_DB_ANALYTICS=true

# Enable automatic index creation
ENABLE_AUTO_INDEXING=true

# Enable connection warming
ENABLE_CONNECTION_WARMING=true

# Enable query optimization
ENABLE_QUERY_OPTIMIZATION=true