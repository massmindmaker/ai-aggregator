# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Neon connection parameters
PGHOST="ep-xxx-pooler.aws.neon.tech"
PGHOST_UNPOOLED="ep-xxx.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="your-password"

# Vercel Postgres compatibility
POSTGRES_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_HOST="ep-xxx-pooler.aws.neon.tech"
POSTGRES_PASSWORD="your-password"
POSTGRES_DATABASE="neondb"
POSTGRES_PRISMA_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"

# ===========================================
# Neon Auth (Stack Auth)
# ===========================================
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_xxx"
STACK_SECRET_SERVER_KEY="ssk_xxx"

# ===========================================
# NextAuth.js
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# OAuth Providers (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# Tinkoff Acquiring
# ===========================================
TINKOFF_TERMINAL_KEY="your-terminal-key"
TINKOFF_SECRET_KEY="your-secret-key"
TINKOFF_API_URL="https://securepay.tinkoff.ru/v2"

# ===========================================
# TON payments (AG-TON-L) — Web (apps/web)
# ===========================================
# Рекомендуется: переменные держать закомментированными и включать осознанно.
# Подробности запуска: docs/ops/TON-ONLY-RUNBOOK.md
# TON_WALLET_ENABLED=1                          # 1 = TON-кошелёк/чекаут включены; иначе все роуты /api/ton/* дают 503 TON_WALLET_DISABLED
# TON_WALLET_ORIGIN=https://ai-aggregator.ru    # строгий origin для /api/ton/* (проверки Origin + sec-fetch-site; только https, без пути/query)
# TON_WALLET_NETWORK=-3                         # сейчас принимается только -3 (testnet); -1 (mainnet) — после миграции 0098 и параметризации web-слоя
# TON_CHECKOUT_POLICY=                          # JSON политики чекаута (zod: recipient, fx, пакеты 1-20). В проде наполняется из admin_settings (ключ ton_checkout_policy); env — только для локальной разработки

# TON payments (AG-TON-L) — Worker (apps/worker)
# TON_RECONCILIATION_MODE=disabled              # disabled | observe | settle; любое другое значение — startup-отказ воркера (TON_RECONCILIATION_STARTUP_REFUSED). Режим settle активируется после Phase 3 плана (миграция 0099 + снятие гейта TON_RUNTIME_SETTLEMENT_FORBIDDEN)
# TON_RECONCILIATION_NETWORK=tvm:-3             # точное совпадение с константой кода, иначе startup-отказ
# TON_RECONCILIATION_ASSET_KIND=native          # только native
# TON_RECONCILIATION_PROVIDER_ID=toncenter-v3-testnet
# TON_RECONCILIATION_PROVIDER_ORIGIN=https://testnet.toncenter.com
# TON_RECONCILIATION_VERIFIER_VERSION=aiag-toncenter-v3-verifier-v1
# TON_RECONCILIATION_FINALITY_POLICY_ID=toncenter-v3-testnet-provider-attested-mc-depth-2-v1
# TON_RECONCILIATION_SOURCE_ID=                 # опц.: хеш одного source — ограничить свип одним источником для отладки
# TON_SETTLEMENT_CONFIRMATION=                  # только для MODE=settle: строка I-UNDERSTAND-WORKER-ONLY-SETTLEMENT (двойной гейт вместе с worker-only DB-ролью aiag_ton_worker)
# TONCENTER_API_KEY=                            # X-API-Key для TonCenter (для mainnet обязателен; подключение — Phase 1.3 плана)
# TON_EVIDENCE_CROSSCHECK=0                     # 1 = сверка masterchain root с TonAPI v2 (второй источник); на mainnet-пресете включается по умолчанию
# TON_POLICY_TEMPLATE=                          # JSON без usdPerTon (recipient, revision, finalityPolicyId, verifierVersion, packages[]); при наличии — воркер каждые 60 с обновляет ton_checkout_policy в admin_settings (FX-метка честная: протухший курс НЕ перештамповывается)

# Прод-заметка (TON-only): фиат отключается ОТСУТСТВИЕМ TINKOFF_*/YOOKASSA_* переменных.

# ===========================================
# S3 Storage (Yandex Cloud Object Storage)
# ===========================================
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="aiag-storage"
S3_REGION="ru-central1"

# ===========================================
# Redis (for rate limiting and caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# Application
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
