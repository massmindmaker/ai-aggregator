# TON testnet acceptance — configuration template (NOT applied to any host).
#
# Copy into the runtime env of a disposable/testnet deployment. Never paste into
# /srv/aiag/shared/.env without the owner's explicit go-ahead: that file is prod.
#
# Recipient is the owner-created testnet wallet (workchain 0, -3 testnet):
#   friendly  kQCog20TguYAI3TnYy0aba7jRrPO6CFbFwgGGLpIxRNwgb1o
#   raw       0:a8836d1382e6002374e7632d1a6daee346b3cee8215b17080618ba48c5137081
# Every guard in the codebase (zod policy, ton_invoices.recipient, migration 0091,
# the reconciler's source identity hash) works on the raw form, so the raw form is
# what goes into TON_CHECKOUT_POLICY.recipient.

# ---------------------------------------------------------------- web (checkout)
TON_WALLET_ENABLED="1"
# Must be exactly "-3". tonConfig() throws TON_WALLET_CONFIGURATION_UNAVAILABLE otherwise.
TON_WALLET_NETWORK="-3"
# https, no credentials, no path, no query, no fragment, hostname with a dot.
# http://127.0.0.1 is only accepted with AIAG_TEST_DATABASE=1 and a loopback DATABASE_URL.
TON_WALLET_ORIGIN="https://<your-testnet-host>"

# Strict zod: recipient ^0:[a-f0-9]{64}$, network literal "tvm:-3", 1..20 packages,
# fx.numerator/denominator positive, quoteLifetimeSeconds 30..600, maxFxAgeSeconds 1..86400.
# fx.observedAtMs/expiresAtMs are absolute epoch ms and MUST be refreshed as the
# rate ages; createTonCheckout rejects a stale window with TON_CHECKOUT_FX_STALE.
# observedAtMs must be <= now, expiresAtMs must be > now.
TON_CHECKOUT_POLICY='{"revision":"testnet-acceptance-v1","recipient":"0:a8836d1382e6002374e7632d1a6daee346b3cee8215b17080618ba48c5137081","network":"tvm:-3","finalityPolicyId":"toncenter-v3-testnet-provider-attested-mc-depth-2-v1","verifierVersion":"aiag-toncenter-v3-verifier-v1","quoteLifetimeSeconds":300,"maxFxAgeSeconds":600,"fx":{"numerator":"1000","denominator":"1","rounding":"ceil","source":"testnet-acceptance-fx-v1","observedAtMs":0,"expiresAtMs":0},"additionalFeeAtomic":"0","packages":[{"id":"testnet-topup","label":"Testnet top-up","grantMicrocredits":"1000000"}]}'

# ------------------------------------------------------------ worker (observe)
# parseTonObservationStartup accepts exactly two modes: disabled (default) and observe.
# Any other mode, or any other network/asset/provider/verifier/finality value, throws
# TON_OBSERVATION_STARTUP_REFUSED at worker boot. There is no settlement mode.
TON_RECONCILIATION_MODE="observe"
TON_RECONCILIATION_NETWORK="tvm:-3"
TON_RECONCILIATION_ASSET_KIND="native"
# the literal values the guard compares against, from apps/worker/src:
TON_RECONCILIATION_PROVIDER_ID="toncenter-v3-testnet"
TON_RECONCILIATION_PROVIDER_ORIGIN="https://testnet.toncenter.com"
TON_RECONCILIATION_VERIFIER_VERSION="aiag-toncenter-v3-verifier-v1"
TON_RECONCILIATION_FINALITY_POLICY_ID="toncenter-v3-testnet-provider-attested-mc-depth-2-v1"
# Optional: sha256-shaped source id, hashed again by the parser before use.
# TON_RECONCILIATION_SOURCE_ID="<64 hex>"
# Must be a bare postgres URL. connect_timeout / statement_timeout / query_timeout /
# lock_timeout / idle_in_transaction_session_timeout / options are refused, and so is
# any url with a hash, no hostname, or a non-postgres scheme.
# DATABASE_URL="postgresql://<user>@<host>/<db>"

# ------------------------------------------------------------------- provider key
# TON Center v3 testnet answers unauthenticated but rate-limited. The shipped provider
# (apps/worker/src/ton-payment-provider.ts) sends no api key today, so sustained
# scanning needs one wired in first. Owner decision, not a config line.
# TON_CENTER_API_KEY="<key>"
