{
  "name": "aiag-migration-testing",
  "version": "1.0.0",
  "description": "Comprehensive testing suite for AI Aggregator migration to Vercel",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance",
    "test:security": "jest tests/security",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "test:load": "artillery run tests/performance/load-test.yml",
    "test:performance:serverless": "jest tests/performance/vercel-functions-performance.test.js",
    "test:performance:load": "artillery run tests/performance/load-test.yml",
    "test:performance:basic": "node scripts/basic-performance-check.js",
    "test:security:auth": "jest tests/security/auth-security.test.js",
    "test:security:cors": "jest tests/security/cors-security.test.js",
    "test:security:validation": "jest tests/security/input-validation.test.js",
    "test:security:penetration": "node scripts/security-penetration-test.js",
    "test:security:vulnerability": "npm audit --audit-level high",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance",
    "test:comprehensive": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:performance && npm run test:e2e",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:staging": "cross-env NODE_ENV=staging npm run test:all",
    "test:production": "cross-env NODE_ENV=production npm run test:performance",
    "test:health": "node scripts/health-check.js",
    "test:health:yandex": "node scripts/health-check-yandex.js",
    "test:api:health": "node scripts/api-health-check.js",
    "test:deployment": "node scripts/deployment-test.js",
    "test:deployment:validation": "node scripts/deployment-validation.js",
    "test:migration": "node scripts/migration-test.js",
    "test:migration:dependencies": "node scripts/check-migration-dependencies.js",
    "test:migration:backup-validation": "node scripts/validate-backup-procedures.js",
    "test:migration:data-consistency": "node scripts/check-data-consistency.js",
    "test:migration:vercel-config": "node scripts/validate-vercel-config.js",
    "test:migration:verification": "cypress run --spec cypress/e2e/migration-verification.cy.js",
    "test:migration:readiness-report": "node scripts/generate-readiness-report.js",
    "test:rollback:validation": "node scripts/validate-rollback.js",
    "test:rollback:report": "node scripts/generate-rollback-report.js",
    "test:regression": "node scripts/regression-test.js",
    "test:compatibility": "node scripts/compatibility-test.js",
    "test:smoke:production": "node scripts/production-smoke-test.js",
    "test:health:production": "node scripts/production-health-check.js",
    "test:final:validation": "node scripts/final-validation-test.js",
    "test:pre-migration": "node scripts/pre-migration-test.js",
    "test:performance:post-migration": "node scripts/post-migration-performance.js",
    "test:performance:baseline": "node scripts/performance-baseline.js",
    "test:performance:compare": "node scripts/performance-compare.js",
    "test:performance:sustained": "artillery run tests/performance/sustained-load.yml",
    "test:performance:scaling": "artillery run tests/performance/scaling-test.yml",
    "test:performance:memory": "node scripts/memory-performance-test.js",
    "test:performance:cold-start": "node scripts/cold-start-test.js",
    "test:report": "node scripts/generate-test-report.js",
    "test:health:report": "node scripts/generate-health-report.js",
    "test:comprehensive:report": "node scripts/generate-comprehensive-report.js",
    "test:performance:report": "node scripts/generate-performance-report.js",
    "test:security:report": "node scripts/generate-security-report.js",
    "test:migration:report": "node scripts/generate-migration-report.js",
    "test:migration:database:report": "node scripts/generate-database-migration-report.js",
    "db:setup": "node scripts/setup-test-databases.js",
    "monitoring:setup": "node scripts/setup-monitoring.js",
    "monitoring:24h": "node scripts/24h-monitoring.js",
    "monitoring:report": "node scripts/generate-monitoring-report.js",
    "start:test-server": "node scripts/start-test-server.js",
    "benchmark": "node scripts/benchmark.js",
    "pre-migration": "node scripts/pre-migration-tests.js",
    "post-migration": "node scripts/post-migration-tests.js",
    "rollback-test": "node scripts/rollback-test.js"
  },
  "dependencies": {
    "jest": "^29.7.0",
    "cypress": "^13.6.0",
    "artillery": "^2.0.0",
    "supertest": "^6.3.3",
    "axios": "^1.6.0",
    "mongodb": "^6.3.0",
    "pg": "^8.11.3",
    "@vercel/blob": "^0.15.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sharp": "^0.32.6",
    "puppeteer": "^21.5.2",
    "lighthouse": "^11.4.0",
    "jest-junit": "^16.0.0",
    "jest-html-reporters": "^3.1.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "babel-jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "jest-environment-node": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-jest": "^27.6.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "../aiag_back/**/*.js",
      "../aiaghub/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": ["<rootDir>/setup/jest.setup.js"],
    "testTimeout": 30000
  }
}