# Testing Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGODB_TEST_URI=mongodb://localhost:27017/aiag_test
POSTGRES_TEST_URI=postgresql://localhost:5432/aiag_hub_test
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aiag_production
POSTGRES_URI=postgresql://user:password@host:5432/aiag_hub_production

# Vercel Configuration
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_BLOB_TOKEN=your_vercel_blob_token

# Test Configuration
LOCAL_URL=http://localhost:3000
VERCEL_URL=https://your-app.vercel.app
STAGING_URL=https://staging.your-app.vercel.app
PRODUCTION_URL=https://your-app.com

# Authentication
JWT_SECRET=your_jwt_secret_for_testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# External Services
YANDEX_CLOUD_ACCESS_KEY=your_yandex_access_key
YANDEX_CLOUD_SECRET_KEY=your_yandex_secret_key
YANDEX_BUCKET_NAME=your_yandex_bucket

# Migration Configuration
MIGRATION_START_TIME=2024-01-01T00:00:00Z
BACKUP_LOCATION=./backups
ROLLBACK_TIME_LIMIT=3600000

# Monitoring and Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/WEBHOOK
MONITORING_API_KEY=your_monitoring_api_key

# Performance Testing
ARTILLERY_TARGET=https://your-app.vercel.app
LOAD_TEST_DURATION=300
LOAD_TEST_ARRIVAL_RATE=10

# Cypress Configuration
CYPRESS_RECORD_KEY=your_cypress_record_key
CYPRESS_BASE_URL=http://localhost:3000

# Security Testing
SECURITY_SCAN_TARGET=https://your-app.com
OWASP_ZAP_RULES_FILE=.zap/rules.tsv

# Node Environment
NODE_ENV=test